 <application android:label="@string/app_name" android:icon="@android:drawable/ic_menu_mapmode" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:supportsRtl="true" android:debuggable="true" android:usesCleartextTraffic="false">
