 <string name="app_name">SAICLink 地图试验 E6</string>
 <string name="instructions">驻车测试：先开启无障碍 → 连接车机 → 开始投屏。\n无障碍服务连接后才能开始屏幕投屏。</string>
 <string name="connect">2　连接车机 USB</string><string name="capture">3　开始屏幕投屏</string>
